    },
    "去点亮一个足迹，明年今日就有得回看了 ✦": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去点亮一个足迹，明年今日就有得回看了 ✦"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light a footprint — next year you'll revisit it ✦"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضئ بصمة — وستتذكرها في العام القادم ✦"
          }
        }
      }
    },
    "去年此刻，你在 %@ ✦": {
